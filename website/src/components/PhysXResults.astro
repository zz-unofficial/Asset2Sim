chart-legend .legend-best{background:#315d42}.physx-metric-toolbar{display:flex;justify-content:flex-end;align-items:center;gap:16px;margin-top:18px}.physx-metric-nav{display:flex;gap:8px}.physx-metric-nav button{border:1px solid #cdd9cf;background:#fff;color:#3d5244;border-radius:8px;padding:8px 13px;font-size:18px;line-height:1;cursor:pointer}.physx-metric-nav button:disabled{opacity:.3;cursor:default}.physx-metric-carousel{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:12px;scrollbar-width:thin;scrollbar-color:#b5c9b9 transparent;margin-top:16px}.physx-metric-carousel>.physx-metric{flex:0 0 calc((100% - 28px)/3);min-width:0;box-sizing:border-box;scroll-snap-align:start}.physx-metric{padding:24px}.physx-metric-title{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:24px}.physx-metric-title h3{font-size:21px;color:#17251d;margin:0}.physx-metric-title>span{font-size:10px;letter-spacing:.08em;color:#8c998f}.physx-row{margin:0 0 14px}.physx-row-label{display:flex;justify-content:space-between;gap:10px;font-size:13px;color:#324b39;margin-bottom:5px}.physx-bar{height:8px;background:#edf1ed}.physx-bar-fill{height:100%;background:#b8c5ba}.physx-bar-fill.is-best{background:#315d42}.physx-axis{border-top:1px solid #e1e7e1;display:flex;justify-content:space-between;padding-top:8px;color:#8e9a90;font-size:12px}.physx-audit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}.physx-audit-grid article{padding:20px 22px}.physx-audit-grid strong{display:block;margin-top:8px;font-size:28px;color:#203c2c}.physx-audit-grid p{font-size:12px;color:#78847a;line-height:1.5;margin:6px 0 0}.physx-review-heading{margin:42px 0 16px}.physx-review-heading h3{font-size:26px;color:#17251d;margin:0}.physx-review-heading p{font-size:14px;color:#78847a;margin:8px 0 0}.physx-review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.physx-review-context{font-size:13px;line-height:1.5;color:#78847a;margin:0 0 20px}.physx-review-coverage{display:flex;align-items:baseline;gap:10px;margin:16px 0}.physx-review-coverage strong{font-size:32px;color:#203c2c}.physx-review-coverage span{font-size:13px;color:#78847a}.physx-review-coverage+.physx-bar{margin-bottom:16px}.physx-review-table td:not(:first-child){white-space:normal;min-width:240px;line-height:1.5}.physx-full{margin-top:16px}.physx-property{border-top:1px solid #e5eae6}.physx-property summary{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;cursor:pointer;font-weight:650;color:#203c2c;font-size:14px}.physx-property summary span{font-size:12px;color:#93a097;font-weight:400}.physx-property summary::-webkit-details-marker{display:none}.physx-full summary{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;cursor:pointer;font-weight:650;color:#203c2c}.physx-full summary span{font-size:12px;color:#93a097;font-weight:400}.physx-full summary::-webkit-details-marker{display:none}.physx-table-scroll{overflow:auto;padding:0 24px 24px}.physx-table-scroll table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.physx-table-scroll th,.physx-table-scroll td{text-align:center;padding:10px;border-bottom:1px solid #edf1ed;white-space:nowrap}.physx-table-scroll th{color:#738078}.physx-protocol{color:#78847a;font-size:12px;line-height:1.7;margin:14px 0 0}.physx-protocol a{color:#527c5f;text-decoration:underline}@media(max-width:820px){.physx-metric-carousel>.physx-metric{flex-basis:calc((100% - 14px)/2)}.physx-eval-head{grid-template-columns:1fr}.physx-stats{justify-content:flex-start}.pipeline{grid-template-columns:1fr 1fr}}@media(max-width:720px){.physx-metric-carousel>.physx-metric{flex-basis:100%}.followup-views{grid-template-columns:1fr}.physx-section{padding:45px 16px}.physx-heading{align-items:start;flex-direction:column}.physx-stage-grid{grid-template-columns:1fr}.physx-input{border-left:0;border-top:1px solid #e5eae6}.physx-input-frame{max-width:200px}.physx-stage model-viewer{height:340px}.physx-stage-bottom span:last-child{display:none}.physx-detail,.physx-metric-grid{grid-template-columns:1fr}.physx-audit-grid{grid-template-columns:1fr}.physx-stats{flex-wrap:wrap}.physx-evaluation{margin-top:65px}}
</style>
