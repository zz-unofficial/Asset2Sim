---
import metrics from '../research/metrics.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = { metal: 'Chrome stool', wood: 'Wood tables', ceramic: 'Ceramic vase', plastic: 'Shredder', leather: 'Leather chair', fabric: 'Fabric chair', basket: 'Open basket', bottle: 'Bottle', dinosaur: 'Dinosaur' };
---
<section class="gen-results not-prose full-bleed" data-base={base}>
  <div class="gen-wrap">
    <p class="eyebrow">INTERACTIVE RESULTS <span>01 / 03</span></p>
    <div class="intro"><div><h2>Explore in 3D<span>.</span></h2><p>One image. Three reconstructions.<br />Compare their geometry and appearance.</p></div><div class="intro-note">GSO32 / ABO6 · aligned diagnostic<br/>Drag to rotate · Scroll to zoom</div></div>
    <div class="explorer">
      <div class="explorer-top"><div><span class="subtle">SELECT AN OBJECT</span><div class="case-buttons" role="group" aria-label="Choose an object">{Object.entries(labels).map(([id,label],i)=><button type="button" data-case={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div></div><span class="index">01 — 09</span></div>
      <div class="stage-grid"><div class="stage"><div class="stage-head"><span>3D RECONSTRUCTION</span><span id="model-name">SF3D</span></div><model-viewer id="result-viewer" src={`${base}/research/abo6/metal/sf3d.glb`} alt="SF3D reconstruction of the chrome stool" camera-controls touch-action="pan-y" orientation="0deg -90deg 0deg" shadow-intensity="0.6" exposure="1" loading="lazy"></model-viewer><div class="stage-foot"><span id="model-state" role="status">Loading 3D model…</span><span>DRAG TO ROTATE &nbsp; / &nbsp; SCROLL TO ZOOM</span></div></div>
      <aside class="input-panel"><span class="subtle">INPUT IMAGE</span><div class="input-box"><img id="input-image" src={`${base}/research/abo6/metal/input.png`} alt="Input image of the chrome stool" /></div><h3 id="object-name">Chrome stool</h3><p id="case-meta">ABO6 · view 012<br/>Same input for all three models</p><span class="input-tag">REAL EXPERIMENT INPUT</span></aside></div>
      <div class="model-row"><span class="subtle">MODEL</span><div role="group" aria-label="Choose a model" class="model-buttons"><button type="button" data-model="sf3d" aria-pressed="true">SF3D</button><button type="button" data-model="spar3d" aria-pressed="false">SPAR3D</button><button type="button" data-model="trellis2" aria-pressed="false">TRELLIS.2</button></div><span class="model-hint">Select a model to compare</span></div>
    </div>
    <p class="caption">Data: <a href="https://amazon-berkeley-objects.s3.amazonaws.com/index.html">ABO / Amazon.com</a> and <a href="https://research.google/blog/scanned-objects-by-google-research-a-dataset-of-3d-scanned-common-household-items/">GSO / Google Research</a> · CC BY 4.0.</p>
    <div class="quant" id="quantitative-results"><p class="eyebrow">EVALUATION <span>02 / 03</span></p><div class="quant-heading"><div><h2>Quantitative results<span>.</span></h2><p>Object-level medians under the shared evaluation protocol.</p></div><p class="quant-summary">32 GSO objects / 6 ABO objects<br/>15 novel views per input · aligned diagnostic</p></div>
      <div class="quant-toolbar"><div class="dataset-buttons" role="group" aria-label="Dataset"><span class="subtle">DATASET</span><button type="button" data-dataset="GSO32" aria-pressed="true">GSO32 <small>32 objects</small></button><button type="button" data-dataset="ABO6" aria-pressed="false">ABO6 <small>6 objects</small></button></div><div class="metric-nav"><span class="subtle">METRICS</span><button type="button" id="metric-prev" aria-label="Previous metrics">←</button><button type="button" id="metric-next" aria-label="Next metrics">→</button></div></div>
      <p class="slide-hint">Compare three metrics at a time · use the arrows or swipe horizontally</p><div class="chart-legend" aria-label="Chart colors"><span><i class="legend-best"></i> Best displayed value</span><span><i class="legend-other"></i> Other values</span></div><div id="metric-chart" class="metric-carousel" aria-label="Metric comparisons" tabindex="0"></div>
      <details class="detail"><summary><span>Full results <small>All metrics &amp; object-level data</small></span><span class="plus">＋</span></summary><div class="detail-body"><p>Object-level medians from the aligned diagnostic. Metric descriptions and valid / planned counts are shown below; image metrics are novel-view averages per object.</p><div class="table-scroll"><table><thead><tr><th>Metric</th><th>Valid / planned</th><th>SF3D</th><th>SPAR3D</th><th>TRELLIS.2</th></tr></thead><tbody id="summary-table"></tbody></table></div><details class="object-details"><summary>Object-level values <small>all reported metrics</small></summary><div class="table-scroll"><table id="object-table"></table></div></details></div></details>

    </div>
  </div>
  <script is:inline type="application/json" id="research-metrics" set:html={JSON.stringify(metrics).replaceAll('<','\\u003c')} />
</section>
<script>
  import '@google/model-viewer';
  import '../research/results.js';
</script>
<style is:global>
.gen-results{background:#f6f7f4;color:#141a19;padding:clamp(48px,6vw,88px) 24px;font-family:system-ui,sans-serif}.gen-wrap{max-width:1320px;margin:auto}.eyebrow,.subtle,.index,.stage-head,.stage-foot,.input-tag{font-size:13px;font-weight:700;letter-spacing:.12em;color:#6c7772}.eyebrow{display:flex;justify-content:space-between;border-top:1px solid #bdc8be;padding-top:14px;color:#47735c}.intro,.quant-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin:34px 0}.intro h2,.quant h2{font-size:clamp(38px,5vw,64px);font-weight:650;letter-spacing:-.055em;line-height:1;color:#17251d;margin:0}.intro h2 span,.quant h2 span{color:#71a67c}.intro p,.quant-heading p{font-size:16px;line-height:1.6;color:#69746d;margin:16px 0 0}.intro-note{font-size:14px;line-height:1.8;letter-spacing:.06em;text-align:right;color:#7b857f}.explorer,.chart-card,.detail{border:1px solid #dce3dd;background:white;border-radius:14px;overflow:hidden}.explorer-top,.model-row{padding:18px 22px;display:flex;justify-content:space-between;align-items:center;gap:14px}.case-buttons,.model-buttons{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.gen-results button,.gen-results select{cursor:pointer}.case-buttons button,.model-buttons button{border:1px solid #e1e7e2;background:#fff;border-radius:6px;padding:8px 12px;color:#657169;font-size:15px}.case-buttons button[aria-pressed=true],.model-buttons button[aria-pressed=true]{background:#203c2c;border-color:#203c2c;color:white}.stage-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;border-top:1px solid #e5eae6;border-bottom:1px solid #e5eae6}.stage{min-width:0;background:#e9ede9;position:relative}.stage-head,.stage-foot{position:absolute;left:20px;right:20px;display:flex;justify-content:space-between;z-index:1;pointer-events:none}.stage-head{top:18px}.stage-foot{bottom:16px;font-size:12px}model-viewer{width:100%;height:490px;background:radial-gradient(ellipse at center,#f9faf8,#e5eae5);--poster-color:transparent}.input-panel{padding:22px;border-left:1px solid #e5eae6}.input-box{background:#f2f4f0;border-radius:8px;aspect-ratio:1;display:grid;place-items:center;margin:15px 0}.input-box img{width:100%;height:100%;object-fit:contain}.input-panel h3{font-size:22px;margin:14px 0 6px}.input-panel p{color:#7a857e;font-size:15px;line-height:1.7}.input-tag{display:inline-block;border:1px solid #dbe4db;border-radius:99px;padding:7px;margin-top:18px;color:#6b8772}.model-row{justify-content:start}.model-buttons{margin:0}.model-hint{margin-left:auto;color:#85938a;font-size:14px}.caption{font-size:12px;line-height:1.7;color:#78847a;margin:14px 0 0}.caption a{color:#527c5f;text-decoration:underline}.quant{margin-top:100px}.controls{display:flex;gap:12px;flex-wrap:wrap}.controls label{display:grid;gap:7px;font-size:10px;letter-spacing:.12em;color:#718077;font-weight:700}.controls select{min-width:180px;padding:10px;border:1px solid #dbe3dc;border-radius:7px;background:white;color:#273c2e;font-size:13px}.chart-card{padding:28px}.chart-title{display:flex;justify-content:space-between;gap:16px}.chart-title h3{margin:7px 0;font-size:20px}.chart-title p,.chart-note,.detail p{font-size:12px;color:#78847a;line-height:1.6}.count{font-size:11px;color:#708074}.bars{display:grid;gap:18px;margin-top:28px}.bar-row{display:grid;grid-template-columns:85px 1fr 85px;align-items:center;gap:16px;font-size:13px}.bar-track{height:14px;background:#edf1ed;border-radius:20px;overflow:hidden}.bar-fill{height:100%;border-radius:20px;background:#72957b}.bar-row:nth-child(2) .bar-fill{background:#9bb5a0}.bar-row:nth-child(3) .bar-fill{background:#315d42}.bar-value{text-align:right;font-variant-numeric:tabular-nums}.chart-note{margin:20px 0 0}.detail{margin-top:12px}.detail summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;padding:20px 24px;font-weight:650}.detail summary::-webkit-details-marker{display:none}.detail small{font-size:12px;font-weight:400;color:#93a097;margin-left:12px}.plus{font-size:20px;color:#6f8c76}.detail[open] .plus{transform:rotate(45deg)}.detail-body{padding:0 24px 24px}.table-scroll{overflow:auto;max-height:430px}.gen-results table{border-collapse:collapse;width:100%;font-size:12px;text-align:left}.gen-results th,.gen-results td{text-align:center;padding:10px;border-bottom:1px solid #edf1ed;white-space:nowrap}.gen-results th{position:sticky;top:0;background:white;color:#738078}.gen-results td:not(:first-child){font-variant-numeric:tabular-nums}@media(max-width:720px){.gen-results{padding:45px 16px}.intro,.quant-heading{align-items:start;flex-direction:column}.intro-note{display:none}.stage-grid{grid-template-columns:1fr}.input-panel{border-left:0;border-top:1px solid #e5eae6;display:grid;grid-template-columns:100px 1fr;column-gap:16px}.input-panel .subtle{grid-column:1/-1}.input-box{grid-row:2/5;margin:10px 0}.input-panel h3{margin:12px 0 0}.input-panel p{margin:3px 0}.input-tag{display:none}model-viewer{height:340px}.model-hint,.stage-foot span:last-child{display:none}.model-row{flex-wrap:wrap}.bar-row{grid-template-columns:70px 1fr 65px;gap:8px}.controls select{min-width:135px}.quant{margin-top:65px}}

.chart-legend{display:flex;gap:18px;flex-wrap:wrap;margin:0 0 16px;color:#65766a;font-size:13px}.chart-legend span{display:inline-flex;align-items:center;gap:7px}.chart-legend i{width:12px;height:12px;border-radius:3px;display:inline-block;background:#b8c5ba}.chart-legend .legend-best{background:#315d42}.quant-heading {align-items:end}.quant-summary {font-size:15px!important;line-height:1.7!important;text-align:right}.quant-toolbar {display:flex;justify-content:space-between;align-items:end;gap:20px;margin:28px 0 8px}.dataset-buttons,.metric-nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.dataset-buttons .subtle,.metric-nav .subtle{margin-right:8px}.dataset-buttons button,.metric-nav button{border:1px solid #cdd9cf;background:#fff;color:#3d5244;border-radius:8px;padding:10px 15px;font-size:16px}.dataset-buttons button[aria-pressed=true]{background:#203c2c;border-color:#203c2c;color:white}.dataset-buttons small{opacity:.7;margin-left:5px}.metric-nav button{font-size:18px;line-height:1;padding:8px 13px}.metric-nav button:disabled{opacity:.3;cursor:default}.slide-hint{font-size:15px;color:#819087;margin:12px 0 16px}.metric-carousel{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:12px;scrollbar-width:thin;scrollbar-color:#b5c9b9 transparent}.metric-card{flex:0 0 calc((100% - 28px)/3);min-width:0;scroll-snap-align:start;background:#fff;border:1px solid #dce3dd;border-radius:12px;padding:24px;box-sizing:border-box}.metric-card h3{font-size:22px;line-height:1.3;margin:0;color:#192d20;font-weight:650}.metric-card .metric-context{min-height:44px;color:#859188;font-size:14px;line-height:1.5;margin:6px 0 20px}.metric-card .model-stat{margin:0 0 19px}.metric-card .stat-label{display:flex;justify-content:space-between;gap:8px;font-size:16px;margin-bottom:8px}.metric-card .bar-track{height:9px;border-radius:0}.metric-card .bar-fill{border-radius:0}.metric-card .axis{border-top:1px solid #e1e7e1;display:flex;justify-content:space-between;padding-top:8px;color:#8e9a90;font-size:13px}.insight{margin:20px 0;background:#e8eee8;border-left:3px solid #799d80;padding:15px 18px;color:#516456;font-size:13px;line-height:1.7}.insight strong{color:#24452e}.object-details{margin-top:20px;border-top:1px solid #edf1ed}.object-details summary{padding:18px 0}.object-details .table-scroll{max-height:430px}.object-details table{min-width:1900px}.object-details th,.object-details td{min-width:105px;white-space:nowrap}.object-details th:first-child,.object-details td:first-child{min-width:155px}@media(max-width:900px){.metric-card{flex-basis:calc((100% - 14px)/2)}}@media(max-width:620px){.metric-card{flex-basis:100%}.quant-toolbar{align-items:start;flex-direction:column}.quant-summary{text-align:left}}
</style>
