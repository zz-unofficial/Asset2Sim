:#34493b;font-size:13px}.key-divider{border-top:1px solid #e9eee9;margin:2px 0}kbd{display:inline-block;min-width:29px;padding:4px 6px;border:1px solid #d5e0d6;border-bottom-width:2px;border-radius:6px;background:#f6f8f5;text-align:center;font:700 12px system-ui,sans-serif;color:#3d5946}small{color:#9ba99e;font-size:11px}.download-button{display:flex;justify-content:space-between;width:100%;margin-top:16px;padding:11px 14px;border:0;border-radius:7px;background:#203c2c;color:white;font-size:13px;font-weight:600;cursor:pointer}.download-button:hover{background:#315d42}@media(min-width:1024px){.data-card{margin-top:auto}}@media(max-width:1023px){.robot-layout{grid-template-columns:1fr}.scene-card{min-height:500px}#viewport{min-height:380px}.robot-sidebar{display:grid;grid-template-columns:1fr 1fr;align-items:start}}@media(max-width:620px){.robot-section{padding:0 16px}.robot-sidebar{grid-template-columns:1fr}.scene-card{min-height:480px}#viewport{min-height:350px}.scene-header{padding:16px}.status-area{padding:12px 16px}}
</style>
