<div class="not-prose full-bleed robot-section" id="robot-demo">
  <div class="robot-wrap">
    <p class="section-eyebrow">INTERACTIVE SIMULATION</p>
    <div class="section-heading"><h2 id="interactive-demo">Interactive Demo<span>.</span></h2><p>Control the UR5e robot to grasp and release a Reference Box in a physics simulation.</p></div>
    <div class="robot-layout">
      <div class="scene-card">
        <div class="scene-header"><div><span class="label">INTERACTIVE SIMULATION</span><h2>Robot workspace</h2><p>Drag to orbit · Right-drag to pan · Scroll to zoom</p></div><button id="camera-reset" type="button" class="outline-button">Reset view</button></div>
        <div id="viewport" tabindex="0" aria-label="Robot simulation viewport"></div>
        <div class="status-area"><p id="status" role="status">Loading MuJoCo and scene assets…</p></div>
      </div>
      <aside class="robot-sidebar">
        <section class="side-card controls-card"><div class="side-heading"><div><span class="label">INTERACTION</span><h2>Keyboard controls</h2></div><span class="hint">HOLD TO MOVE</span></div><p class="description">Controls are active when the simulation is visible. Directions use world coordinates.</p>
          <div class="key-list">
            <div><span>Forward / Backward <small>±X</small></span><span><kbd>W</kbd> <kbd>S</kbd></span></div>
            <div><span>Left / Right <small>±Y</small></span><span><kbd>A</kbd> <kbd>D</kbd></span></div>
            <div><span>Up / Down <small>±Z</small></span><span><kbd>R</kbd> <kbd>F</kbd></span></div>
            <div class="key-divider"></div>
            <div><span>Rotate X <small>+ / −</small></span><span><kbd>U</kbd> <kbd>O</kbd></span></div>
            <div><span>Rotate Y <small>+ / −</small></span><span><kbd>I</kbd> <kbd>P</kbd></span></div>
            <div><span>Rotate Z <small>+ / −</small></span><span><kbd>H</kbd> <kbd>L</kbd></span></div>
            <div class="key-divider"></div>
            <div><span>Close / Open gripper</span><span><kbd>J</kbd> <kbd>K</kbd></span></div>
            <div><span>Reset simulation</span><kbd>0</kbd></div>
          </div>
        </section>
        <section class="side-card data-card"><span class="label">SESSION</span><h2>Experiment data</h2><p class="description">Save performance and contact measurements.</p><button id="download" type="button" class="download-button">Download data <span aria-hidden="true">↗</span></button></section>
      </aside>
    </div>
  </div>
</div>
<script>import('../studio/main.js').catch((error) => { const status = document.querySelector('#status'); if (status) status.textContent = `Unable to load the simulation module: ${error.message}. Restart the development server and refresh the page.`; });</script>
<style>
